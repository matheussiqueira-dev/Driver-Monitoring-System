# Deploy only the static portfolio surface. The Python/OpenCV DMS stays in GitHub
# for local execution and must not be interpreted as a Vercel Python Function.
/*
!.vercelignore
!vercel.json
!package.json
!index.html
!styles.css
!app.js
!analytics.js
!pwa.js
!favicon.svg
!manifest.webmanifest
!service-worker.js
!robots.txt
!sitemap.xml
!assets/
!assets/**
!scripts/
!scripts/**
