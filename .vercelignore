# Deploy only what the web build needs. The Python/OpenCV engine stays in GitHub
# for local execution and must not be interpreted as a Vercel Python Function.
/*
!.vercelignore
!vercel.json
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!src/
!src/**
!public/
!public/**
!shared/
!shared/scoring-config.json
