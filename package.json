{
  "name": "driver-monitoring-system",
  "version": "1.0.0",
  "private": true,
  "description": "Driver Monitoring System portfolio interface with real-time DMS visualization and dashboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:web": "vitest run",
    "test:python": "python -m unittest discover -s tests",
    "test": "npm run test:web",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:web && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests/web tests/e2e vite.config.ts playwright.config.ts eslint.config.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "computer-vision",
    "driver-monitoring",
    "facemesh",
    "opencv",
    "vercel"
  ],
  "homepage": "https://driver-monitoring-system-two.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/matheussiqueira-dev/Driver-Monitoring-System.git"
  },
  "author": "Matheus Siqueira",
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "type": "module"
}
